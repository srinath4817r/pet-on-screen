{
  "name": "poring-pet",
  "version": "0.1.0",
  "description": "An animated Poring pet for Windows and Android",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "prepare:desktop": "node tools/prepare-renderer.cjs",
    "prepare:android": "npm run prepare:desktop && node tools/prepare-android.cjs",
    "start": "npm run prepare:desktop && electron .",
    "test:ui": "npm run prepare:desktop && node tools/test-ui.cjs",
    "build": "npm run prepare:desktop && electron-builder --win nsis portable",
    "build:android": "npm run prepare:android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.poringpet.desktop",
    "productName": "Poring Pet",
    "asarUnpack": ["desktop/platform-monitor.ps1", "desktop/native/PoringMedia.exe"],
    "files": ["desktop/**/*", "!desktop/native/bin/**", "!desktop/native/obj/**", "!desktop/native/publish/**", "!desktop/native/**/*.pdb", "package.json", "node_modules/three/build/three.min.js"],
    "win": {"target": ["nsis", "portable"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
